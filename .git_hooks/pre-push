#!/usr/bin/env bash

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

log_file="${MENGER_COMMON_PRE_PUSH_LOG:-/tmp/menger-common-pre-push.log}"
: > "$log_file"
exec > >(tee -a "$log_file") 2>&1

echo "=== menger-common pre-push gate ==="
echo "Log: $log_file"

# --- Phase 0: agentic policy checks (instant) ---
if [ -x ./standards/hooks/check-test-justification.sh ]; then
  RANGES=()
  while read -r local_ref local_sha remote_ref remote_sha; do
    if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
      BASE=$(git merge-base origin/main "$local_sha" 2>/dev/null || true)
      [ -n "$BASE" ] && RANGES+=("$BASE..$local_sha")
    else
      RANGES+=("$remote_sha..$local_sha")
    fi
  done
  if [ ${#RANGES[@]} -gt 0 ]; then
    ./standards/hooks/check-test-justification.sh "${RANGES[@]}" || exit 1
    ./standards/hooks/check-rendering-discipline.sh "${RANGES[@]}" || exit 1
  fi
fi

echo "=== Version policy ==="
scripts/check-version-policy.sh

echo "=== sbt launcher ==="
sbt --script-version

echo "=== Quality, tests, package, docs, binary compatibility ==="
sbt clean "scalafix --check" test package doc mimaReportBinaryIssues

echo "=== Coverage ==="
sbt clean coverage test coverageReport
scripts/check-coverage-policy.sh

echo "=== Local publish ==="
sbt publishLocal
sbt "set publishM2Configuration := publishM2Configuration.value.withOverwrite(true)" publishM2

echo "=== Java consumer smoke test ==="
version="$(scripts/check-version-policy.sh --print-version)"
(
  cd smoke-tests/java
  mvn -B -U test -Dmenger.version="$version"
)

echo "=== menger-common pre-push gate passed ==="
